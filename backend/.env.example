# BrandProof Backend Configuration
PROJECT_NAME=BrandProof
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brandproof

# Security & JWT
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External LLM Configuration (Google Gemini / OpenAI compatible)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-1.5-flash

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

